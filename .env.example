# Supabase — use the service role key (server-side only, never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — for transactional email
# Domain: updates.bookpheral.com must be verified in your Resend account
RESEND_API_KEY=re_your_resend_api_key

# Contact form — inbox that receives /contact submissions (server-side only).
# Defaults to NEXT_PUBLIC_CONTACT_EMAIL when unset.
CONTACT_INBOX_EMAIL=info@bookpheral.com

# ─── Public site config (inlined at build time — rebuild after changing) ────
NEXT_PUBLIC_SITE_URL=https://bookpheral.com
# Dashboard app (apps/app) — "Distribute Your Book" links to $NEXT_PUBLIC_APP_URL/signup
NEXT_PUBLIC_APP_URL=https://app.bookpheral.com

NEXT_PUBLIC_CONTACT_ADDRESS="42 Local, Airport Rd, Ikeja, 100271, Lagos"
NEXT_PUBLIC_CONTACT_EMAIL=info@bookpheral.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@bookpheral.com
# Leave empty to hide the phone number on the Contact page
NEXT_PUBLIC_CONTACT_PHONE=

# Social links — leave empty to hide from the footer
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Launch & Founding Educators Circle (ISO 8601, Lagos is +01:00)
NEXT_PUBLIC_LAUNCH_DATE=2026-11-02T00:00:00+01:00
NEXT_PUBLIC_FEC_REGISTRATION_DEADLINE=2026-10-26T23:59:00+01:00
NEXT_PUBLIC_FEC_SEAT_LIMIT=100

# "Last Updated" shown on Terms / Privacy / Refund pages — leave empty to hide
NEXT_PUBLIC_LEGAL_LAST_UPDATED=

# ─── SEO ────────────────────────────────────────────────────────────────────
# Set to "false" on staging/preview deployments: robots.txt disallows all,
# pages get <meta name="robots" content="noindex">, and the sitemap is empty.
NEXT_PUBLIC_SITE_INDEXABLE=true
# Search Console / Bing Webmaster verification codes (content value only) — leave empty to omit
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
